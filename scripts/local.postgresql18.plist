<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LC_ALL</key>
		<string>en_US.UTF-8</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>PathState</key>
		<dict>
			<key>/Volumes/data1/postgresql@18/PG_VERSION</key>
			<true/>
		</dict>
	</dict>
	<key>Label</key>
	<string>local.postgresql18</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
		<string>Background</string>
		<string>LoginWindow</string>
		<string>StandardIO</string>
		<string>System</string>
	</array>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/robertseaman/Claude/mpc_sbn/pg18-start.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Seconds launchd waits after SIGTERM before SIGKILL. The wrapper
	     turns SIGTERM into a fast shutdown, whose end-of-shutdown
	     checkpoint on a 300 GB replica can exceed the 20 s default. -->
	<key>ExitTimeOut</key>
	<integer>120</integer>
	<key>StandardErrorPath</key>
	<string>/opt/homebrew/var/log/postgresql@18.log</string>
	<key>StandardOutPath</key>
	<string>/opt/homebrew/var/log/postgresql@18.log</string>
	<key>WorkingDirectory</key>
	<string>/opt/homebrew</string>
</dict>
</plist>
